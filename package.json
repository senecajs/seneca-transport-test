{
  "name": "@seneca/transport-test",
  "version": "2.0.0",
  "description": "Standard test cases for Seneca transports.",
  "main": "transport-test.js",
  "scripts": {
    "test": "lab -v test/lab.test.js && node --test test/node.test.js",
    "test-lab": "lab -v test/lab.test.js",
    "test-node": "node --test test/node.test.js",
    "coverage": "lab -c -r console -o stdout -r html -o coverage.html test/lab.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-transport-test.git"
  },
  "keywords": [
    "seneca",
    "transport",
    "test"
  ],
  "author": "Richard Rodger (http://richardrodger.com)",
  "contributors": [
    "Marco Piraccini (https://github.com/marcopiraccini)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/senecajs/seneca-transport-test/issues"
  },
  "homepage": "https://github.com/senecajs/seneca-transport-test",
  "peerDependencies": {
    "seneca": "^4.0.0"
  },
  "devDependencies": {
    "@hapi/lab": "^26.0.1",
    "@seneca/transport": "^9.0.0",
    "seneca": "^4.0.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGES.md",
    "transport-test.js",
    "docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
